'TailBound.main_theorem' depends on axioms: [propext, Classical.choice, Quot.sound]
def TailBound.ManuscriptTheorem1.{u} : Prop :=
∀ (α : Type u) [inst : Fintype α] [inst_1 : DecidableEq α] (S : TailBound.FiniteMarkovSemigroup α) (π : α → ℝ),
  S.Irreducible → S.HasStationaryDistribution π → ∀ (τ : ℝ), 0 < τ → TailBound.DimensionFreeTail π (S.kernel τ)
def TailBound.DimensionFreeTail.{u_1} : {α : Type u_1} → [Fintype α] → (α → ℝ) → (α → α → ℝ) → Prop :=
fun {α} [Fintype α] π K =>
  ∃ C, 0 < C ∧ ∀ (n : ℕ), TailBound.TailEstimate (TailBound.tensorWeight π n) (TailBound.tensorKernel K n) C
def TailBound.TailEstimate.{u_1} : {α : Type u_1} → [Fintype α] → (α → ℝ) → (α → α → ℝ) → ℝ → Prop :=
fun {α} [Fintype α] π K C =>
  ∀ (f : α → ℝ),
    (∀ (x : α), 0 ≤ f x) →
      ∀ (η : ℝ),
        1 < η → (TailBound.eventMass π fun x => η * TailBound.mean π f < TailBound.act K f x) ≤ C / (η * √(Real.log η))
