TailBound.lemma2_sharp.{u_1} {α : Type u_1} [Fintype α] [DecidableEq α] [Nonempty α] (π : α → ℝ) (m M : ℝ) (hm : 0 < m)
  (hlower : ∀ (x : α), m ≤ π x) (hupper : ∀ (x : α), π x ≤ M) (hmass : ∑ x, π x = 1) :
  ∃ C,
    0 < C ∧
      ∀ (τ : ℝ),
        0 < τ →
          ∀ (n : ℕ) (f : (Fin n → α) → ℝ),
            (∀ (x : Fin n → α), 0 < f x) →
              TailBound.mean (TailBound.tensorWeight π n) f = 1 →
                ∀ (ℓ : ℝ),
                  2 < ℓ →
                    TailBound.bandMass (TailBound.tensorWeight π n) (TailBound.heat π f τ) ℓ ≤
                      C *
                          (TailBound.refreshRatioBound m M τ ^ 2 *
                            √(Real.log (TailBound.refreshRatioBound m M τ) / (TailBound.refreshRatioBound m M τ - 1))) /
                        √ℓ
TailBound.lemma2_sharp_of_bounds.{u_1} {α : Type u_1} [Fintype α] [DecidableEq α] [Nonempty α] (π : α → ℝ) (m M : ℝ)
  (hm : 0 < m) (hlower : ∀ (x : α), m ≤ π x) (hupper : ∀ (x : α), π x ≤ M) (hmass : ∑ x, π x = 1) (τ : ℝ) (hτ : 0 < τ)
  (n : ℕ) (f : (Fin n → α) → ℝ) (hf : ∀ (x : Fin n → α), 0 < f x)
  (hfm : TailBound.mean (TailBound.tensorWeight π n) f = 1) (ℓ : ℝ) (hℓ : 2 < ℓ) :
  TailBound.bandMass (TailBound.tensorWeight π n) (TailBound.heat π f τ) ℓ ≤
    TailBound.marginalBandConstant (Fintype.card α) m *
        (TailBound.refreshRatioBound m M τ ^ 2 *
          √(Real.log (TailBound.refreshRatioBound m M τ) / (TailBound.refreshRatioBound m M τ - 1))) /
      √ℓ
TailBound.RefreshData.fixed_band_sharp_explicit.{u_1} {α : Type u_1} [Fintype α] [DecidableEq α] [Nonempty α] {n : ℕ}
  (D : TailBound.RefreshData α n) (ℓ : ℝ) (hℓ : 2 < ℓ) :
  D.startBand 2 ℓ ≤ D.sharpBandConstant * (D.κ ^ 2 * √(Real.log D.κ / (D.κ - 1))) / √ℓ
TailBound.main_theorem.{u_1} : TailBound.ManuscriptTheorem1
'TailBound.lemma2_sharp' depends on axioms: [propext, Classical.choice, Quot.sound]
'TailBound.lemma2_sharp_of_bounds' depends on axioms: [propext, Classical.choice, Quot.sound]
'TailBound.RefreshData.fixed_band_sharp_explicit' depends on axioms: [propext, Classical.choice, Quot.sound]
'TailBound.main_theorem' depends on axioms: [propext, Classical.choice, Quot.sound]
def TailBound.marginalBandConstant : ℕ → ℝ → ℝ :=
fun d m => max 8 (8 * ((393216 / m + 512) * (8 * (1 + 3 * ↑d / (4 * m ^ 2))) + 1536 * Real.exp 11 / m))
def TailBound.refreshRatioBound : ℝ → ℝ → ℝ → ℝ :=
fun m M τ => (Real.exp (-τ) + (1 - Real.exp (-τ)) * M) / ((1 - Real.exp (-τ)) * m)
